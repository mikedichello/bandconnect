# ----------------------------------------------------------------------------
# BandConnect environment configuration
# Copy this file to `.env` and fill in the values.
# ----------------------------------------------------------------------------

# Database -------------------------------------------------------------------
# Local dev uses SQLite (zero config). In production the Prisma datasource
# auto-selects Postgres (scripts/set-db-provider.mjs) — no schema edit:
#   • Vercel + Supabase/Postgres integration: it injects POSTGRES_PRISMA_URL
#     (pooled, for the app) + POSTGRES_URL_NON_POOLING (direct, for migrations);
#     nothing to set here.
#   • Any other Postgres (Neon/Railway/…): just set DATABASE_URL to its URL.
DATABASE_URL="file:./dev.db"

# Set by the Vercel/Supabase integration automatically; only set these by hand
# if you wire Postgres manually:
# POSTGRES_PRISMA_URL=""        # pooled (app) — append ?pgbouncer=true&connection_limit=1
# POSTGRES_URL_NON_POOLING=""   # direct (db push / migrations)

# Auth (NextAuth) ------------------------------------------------------------
# Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET="dev-secret-change-me-in-production"
NEXTAUTH_URL="http://localhost:3000"

# App ------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Stripe (subscriptions) -----------------------------------------------------
# Get keys at https://dashboard.stripe.com/test/apikeys
# Leave these blank to run in "billing disabled" mode — the app still works,
# upgrade buttons just show a configuration notice instead of charging.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Stripe Price IDs for the Pro plan (create products in the Stripe dashboard).
STRIPE_PRICE_ID_PRO_MONTHLY=""
STRIPE_PRICE_ID_PRO_YEARLY=""

# Email (Resend) -------------------------------------------------------------
# Transactional email for welcome, password reset, and event reminders.
# Leave RESEND_API_KEY blank to run in "log mode" — emails are logged to the
# console instead of sent, so every flow still works without a key.
# Get a key at https://resend.com. Verify a domain, or use onboarding@resend.dev
# for testing.
RESEND_API_KEY=""
EMAIL_FROM="BandConnect <onboarding@resend.dev>"

# Cron (event reminders) -----------------------------------------------------
# Secret that protects /api/cron/reminders. Vercel Cron sends it automatically
# as a Bearer token when set. Leave blank in dev to leave the endpoint open.
CRON_SECRET=""

# Admin -----------------------------------------------------------------------
# Comma-separated emails allowed to review profile verification requests at
# /dashboard/admin. Leave blank to disable the admin queue entirely.
ADMIN_EMAILS=""

# Demo deploy (preview/dev only) ---------------------------------------------
# Set these ONLY on a throwaway demo project — never on production.
#   DEMO_SEED=1        → the build WIPES + reseeds the DB with CT sample data.
#   NEXT_PUBLIC_DEMO=1 → shows a "Demo site" banner with one-click sample logins.
# DEMO_SEED=""
# NEXT_PUBLIC_DEMO=""
