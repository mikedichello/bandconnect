{
  "name": "bandconnect",
  "version": "0.1.0",
  "private": true,
  "description": "A platform connecting local bands and venues — profiles, discovery, calendars, messaging, and subscriptions.",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/set-db-provider.mjs && prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "db:push": "node scripts/set-db-provider.mjs && prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "node scripts/set-db-provider.mjs && prisma db push --force-reset && tsx prisma/seed.ts",
    "db:studio": "prisma studio"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "lucide-react": "^1.21.0",
    "next": "^15.5.20",
    "next-auth": "^4.24.8",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "stripe": "^17.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.16.11",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.20",
    "postcss": "^8.5.10",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  },
  "overrides": {
    "postcss": "$postcss",
    "uuid": "^11.1.1"
  }
}
