// BandConnect data model
// ---------------------------------------------------------------------------
// A calendar-first platform for Connecticut's live-music scene with four
// profile types (Fan, Venue, Musician, Band), events with geo + media, and a
// social graph (follows, friendships, RSVPs).
//
// Dev uses SQLite for zero-config local runs. To deploy on Postgres, change
// `provider` below to "postgresql" and point DATABASE_URL at your database.
// Enum-like fields are modeled as String for SQLite/Postgres portability.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// --- Accounts ---------------------------------------------------------------

model User {
  id           String @id @default(cuid())
  email        String @unique
  passwordHash String
  role         String // "FAN" | "VENUE" | "MUSICIAN" | "BAND"

  // Billing (Stripe)
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  plan                 String    @default("FREE") // "FREE" | "PRO"
  planStatus           String?
  planRenewsAt         DateTime?

  profile Profile?

  sentMessages     Message[]            @relation("SentMessages")
  receivedMessages Message[]            @relation("ReceivedMessages")
  notifications    Notification[]
  resetTokens      PasswordResetToken[]
  savedSearches    SavedSearch[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// --- Unified profile (one per user, type-discriminated) ---------------------

model Profile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type        String // "FAN" | "VENUE" | "MUSICIAN" | "BAND"
  displayName String
  slug        String  @unique
  avatarUrl   String?
  bannerUrl   String?
  tagline     String?
  bio         String? // bio / description

  // Location (used for venues + events; artists may set a home city)
  city    String?
  zip     String?
  address String?
  lat     Float?
  lng     Float?

  // Artist / venue attributes
  genres      String? // comma-separated
  instruments String? // comma-separated (musician)
  websiteUrl  String?
  instagram   String?
  spotify     String?
  youtube     String?
  bandcamp    String?

  // Gig availability (musician / band)
  availableForGigs Boolean @default(false)
  rateMin          Int?
  rateMax          Int?
  rateHidden       Boolean @default(false)

  // Musician seeking flags
  isSolo         Boolean @default(false)
  wantsStartBand Boolean @default(false)
  wantsJoinBand  Boolean @default(false)
  openForFillIns Boolean @default(false)

  // Band seeking flag
  needsMusicians Boolean @default(false)

  // Pro customization
  themeColor String? @default("#7c4dff")
  featured   Boolean @default(false)

  // Trust & verification ("claim your page")
  verified           Boolean   @default(false)
  verificationStatus String    @default("none") // "none" | "pending" | "verified" | "rejected"
  verificationMethod String? // "domain" | "manual"
  verificationInfo   String? // submitted website/socials/notes for review
  verifiedAt         DateTime?

  media           MediaItem[]
  hostedEvents    Event[]            @relation("HostedEvents")
  venueEvents     Event[]            @relation("VenueEvents")
  availability    AvailabilityDate[]
  rsvps           Rsvp[]
  following       Follow[]           @relation("Follower")
  followers       Follow[]           @relation("Following")
  friendshipsSent Friendship[]       @relation("Requester")
  friendshipsRecv Friendship[]       @relation("Addressee")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([availableForGigs])
}

// --- Media gallery (images + video, by URL) ---------------------------------

model MediaItem {
  id        String  @id @default(cuid())
  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  kind         String // "IMAGE" | "VIDEO"
  url          String
  thumbnailUrl String?
  caption      String?
  sortOrder    Int     @default(0)

  createdAt DateTime @default(now())

  @@index([profileId])
}

// --- Events -----------------------------------------------------------------

model Event {
  id            String  @id @default(cuid())
  hostProfileId String
  host          Profile @relation("HostedEvents", fields: [hostProfileId], references: [id], onDelete: Cascade)

  // Optional link to a registered venue profile
  venueProfileId String?
  venue          Profile? @relation("VenueEvents", fields: [venueProfileId], references: [id], onDelete: SetNull)

  title       String
  description String?

  // Cover media: image or video (video plays on the event page; thumbnail used elsewhere)
  coverUrl      String?
  coverType     String  @default("IMAGE") // "IMAGE" | "VIDEO"
  coverThumbUrl String?

  startAt DateTime
  endAt   DateTime?

  familyFriendly Boolean @default(false)
  hasCoverCharge Boolean @default(false)
  genres         String? // comma-separated

  // Location (defaults to Connecticut)
  locationName String?
  address      String?
  city         String?
  zip          String?
  state        String  @default("CT")
  lat          Float?
  lng          Float?

  // Paid promotion ("boost") — featured placement in the calendar
  featured      Boolean   @default(false)
  featuredUntil DateTime?

  rsvps Rsvp[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([startAt])
  @@index([hostProfileId])
  @@index([city])
}

// --- Social graph -----------------------------------------------------------

model Follow {
  id          String  @id @default(cuid())
  followerId  String
  follower    Profile @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String
  following   Profile @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followingId])
}

model Friendship {
  id          String  @id @default(cuid())
  requesterId String
  requester   Profile @relation("Requester", fields: [requesterId], references: [id], onDelete: Cascade)
  addresseeId String
  addressee   Profile @relation("Addressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  status String @default("PENDING") // "PENDING" | "ACCEPTED"

  createdAt DateTime @default(now())

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
}

model Rsvp {
  id        String  @id @default(cuid())
  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  eventId   String
  event     Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)

  status String @default("GOING") // "GOING" | "MAYBE"

  // Set once a pre-show reminder has been delivered (prevents duplicates).
  reminderSentAt DateTime?

  createdAt DateTime @default(now())

  @@unique([profileId, eventId])
  @@index([eventId])
}

// --- Password reset ---------------------------------------------------------

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// --- Saved searches / alerts ------------------------------------------------

model SavedSearch {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  label String
  city  String? // CT town to match (case-insensitive contains)
  genre String? // genre to match

  createdAt DateTime @default(now())

  @@index([userId])
}

model AvailabilityDate {
  id        String  @id @default(cuid())
  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  date DateTime
  note String?

  @@unique([profileId, date])
  @@index([profileId])
}

// --- Messaging & notifications ----------------------------------------------

model Message {
  id          String    @id @default(cuid())
  senderId    String
  sender      User      @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  recipientId String
  recipient   User      @relation("ReceivedMessages", fields: [recipientId], references: [id], onDelete: Cascade)
  body        String
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([senderId, recipientId])
  @@index([recipientId, readAt])
}

model Notification {
  id      String  @id @default(cuid())
  userId  String
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type    String // "FOLLOW" | "FRIEND_REQUEST" | "FRIEND_ACCEPT" | "MESSAGE" | "RSVP" | "SHARE" | "EVENT_REMINDER"
  title   String
  body    String?
  linkUrl String?
  read    Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([userId, read])
}
